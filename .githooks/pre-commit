#!/usr/bin/env bash
# 兜底：拦住个人数据和身份/基础设施信息进公开仓库。
#
# 装（clone 后各自执行一次）：git config core.hooksPath .githooks
# 额外的私有关键词（自己的主机名、项目代号等）写进 .git/private-patterns，
#   一行一个 grep -E 模式；那个文件在 .git/ 里，永远不会被提交。
# 确实是误报：git commit --no-verify（想清楚再用）
set -uo pipefail
staged=$(git diff --cached --name-only --diff-filter=ACM)
[ -z "$staged" ] && exit 0
bad=0

# 1. 路径级：个人数据不该出现在索引里
while IFS= read -r f; do
  case "$f" in
    */private/*|private/*|LOCAL.md|*.jsonl|*chatlog*|*conversations*)
      echo "BLOCK  个人数据路径: $f"; bad=1 ;;
  esac
done <<< "$staged"

# 2. 内容级：IP 和邮箱
patterns='([0-9]{1,3}\.){3}[0-9]{1,3}|[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\.[A-Za-z]{2,}'
extra="$(git rev-parse --git-dir)/private-patterns"
if [ -f "$extra" ]; then
  while IFS= read -r line; do
    [ -n "$line" ] && patterns="$patterns|$line"
  done < "$extra"
fi
allow='you@example\.com|example\.(com|org)|0\.0\.0\.0|127\.0\.0\.1|noreply@'

while IFS= read -r f; do
  [ -f "$f" ] || continue
  # 别扫自己；LICENSE 里的著作权署名是有意公开的，不是泄露
  case "$f" in .githooks/*|LICENSE) continue ;; esac
  case "$f" in *.md|*.sh|*.py|*.txt|*.yml|*.yaml|*.json)
    hits=$(grep -nEI "$patterns" "$f" 2>/dev/null | grep -vE "$allow" || true)
    if [ -n "$hits" ]; then
      echo "BLOCK  可能的私有信息 in $f:"; echo "$hits" | sed 's/^/         /'; bad=1
    fi ;;
  esac
done <<< "$staged"

if [ "$bad" -ne 0 ]; then
  echo
  echo "提交被拦下。个人数据放 private/ 或 LOCAL.md；IP/邮箱/主机名不要写进公开文件。"
  exit 1
fi
exit 0
